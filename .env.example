# =============================================================================
# Course Video Producer v4.0 — Environment Configuration Template (.env.example)
# =============================================================================

# 1. TTS API Keys (Fish Audio s2-pro standard voice; falls back to edge-tts or macOS say if unset)
FISHAUDIO_API_KEY=your_fish_audio_api_key_here
FISH_AUDIO_API_KEY=
FISH_API_KEY=

# 2. Optional LLM Polishing Key (only used when running `edit_storyboard.py polish --mode llm`)
OPENAI_API_KEY=

# 3. Path & Runtime Configuration
COURSE_VIDEO_REMOTION_ROOT=
COURSE_VIDEO_DOWNLOADS_DIR=~/Downloads

# 4. Fallback TTS Voice Names
COURSE_VIDEO_EDGE_VOICE=ja-JP-NanamiNeural
COURSE_VIDEO_SAY_VOICE=Kyoko

# 5. Remote Web Studio Authentication Token (auto-generated when unset)
STUDIO_ACCESS_TOKEN=
